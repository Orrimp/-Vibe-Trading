#!/usr/bin/env bash
# Governance pre-commit gate (2026-07-27 adversarial-review hardening).
#
# Runs the constitutional checks — the ADR-0082 triad lint, the AD-2 anchor
# byte-immutability gate, and (since 2026-11-07, bug-log #154) the verdict-
# transcription fidelity check — before every commit. All are fast
# (~seconds; pure python3 + bash, no cargo). Until this hook existed, the
# gates ran only when an agent remembered (bug-log #66 documents what
# discipline-only enforcement ships).
#
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass (emergencies):    git commit --no-verify
# Docs: docs/runbooks/ops-push-and-cache.md § Local governance hooks
set -euo pipefail
root="$(git rev-parse --show-toplevel)"

# spec_lint.py declares `requires-python = ">=3.11"` in a PEP-723 header, and invoking it as
# `python3 <script>` bypasses that declaration entirely — the gate then dies on
# `ModuleNotFoundError: tomllib` if whatever `python3` resolves to is older. That is not
# hypothetical: it happened on 2026-10-10, mid-session, when a Homebrew update (uv 0.13.0,
# 2026-10-09) left `/usr/bin/python3` 3.9.6 as the only python3 on PATH. The gate had passed all
# morning and then blocked every commit.
#
# `uv run` reads the PEP-723 header and selects (or fetches) a compatible interpreter, so the
# script's own stated requirement is what decides — not whatever is first on PATH today. The
# python3 fallback keeps the hook working on a clone without uv, where it will fail loudly for
# the same reason rather than silently skipping.
if command -v uv >/dev/null 2>&1; then
  uv run --quiet "$root/scripts/spec_lint.py"
else
  python3 "$root/scripts/spec_lint.py"
fi
bash "$root/scripts/verify_anchors.sh" | tail -1

# bug-log #154 (2026-11-07): the F / V / V-REG verdict classifiers each live in a [[bin]],
# so no integration test can call them and each is instead "tested" by a file that
# re-implements it. All three claim the copy is verbatim; nothing enforced the word. This
# pins both sides' branch conditions against a set declared in the script. Same uv-vs-python3
# reasoning as above.
if command -v uv >/dev/null 2>&1; then
  uv run --quiet "$root/scripts/verdict_transcription_check.py"
else
  python3 "$root/scripts/verdict_transcription_check.py"
fi

# bug-log #163: `cargo test` skips a target whose required-features are not enabled
# SILENTLY — no warning, exit 0. 46 test fns across 13 targets had never run in CI and
# nothing said so. This does not decide which features CI enables; it makes every
# feature-gated target DECLARED, so a new silent exclusion cannot be added unseen.
# Same uv-vs-python3 reasoning as above.
if command -v uv >/dev/null 2>&1; then
  uv run --quiet "$root/scripts/feature_gated_targets_check.py"
else
  python3 "$root/scripts/feature_gated_targets_check.py"
fi

# bug-log #179 (2026-11-08): `verify_anchors.sh` above asks whether each anchors.toml row's
# SHA matches a committed body. It is perfectly happy when TWO rows of one scenario point at
# the SAME body — so a re-emission that runs one invocation and writes its output to two rows
# silently merges two friction namespaces, and the gate still prints 119/119. That already
# happened once (the 2026-10-29 re-lock put default zero-slippage output into six CANONICAL
# rows, measured as a 28 pp gap against a real --sim-slippage-bps 8 run) and the next
# re-emission was about to do the mirror of it. This declares how many DISTINCT bodies each
# scenario's rows point at, so neither a collapse nor a split can land unseen.
# Same uv-vs-python3 reasoning as above.
if command -v uv >/dev/null 2>&1; then
  uv run --quiet "$root/scripts/anchor_namespace_collapse_check.py"
else
  python3 "$root/scripts/anchor_namespace_collapse_check.py"
fi

# bug-log #183 durable fix (2026-11-08): the tool that maps every in-test SHA literal to its
# anchors.toml row was never GATED — it appeared in this hook and in CI only inside comments
# ABOUT it. So the 75 pins it checks were verified when somebody remembered to run it, and
# the stale pin of #181 was caught by a Rust test on three CI legs instead, hours later.
# It is pure Python over source + anchors.toml: no cargo, no build, nothing to wait for.
# Same uv-vs-python3 reasoning as above.
if command -v uv >/dev/null 2>&1; then
  uv run --quiet "$root/scripts/check_determinism_anchors.py" --pre-commit
else
  python3 "$root/scripts/check_determinism_anchors.py" --pre-commit
fi

# bug-log #183 (2026-11-08): a body SHA is pinned in anchors.toml AND copied into source.
# When #183 was filed, `check_determinism_anchors.py` synced five of the NINE files that
# mirror a current anchors row, and the uncovered one holding 35 of them took CI red on
# all three legs. The #183 durable fix put eight of the nine under that tool (gated just
# above); this census answers "how many places is a SHA pinned?" mechanically and pins
# the answer, so a stale copy — which stops matching, dropping the file's count — cannot
# land unseen. Its uncovered count is DERIVED from the sync tool's own file list.
# Same uv-vs-python3 reasoning as above.
if command -v uv >/dev/null 2>&1; then
  uv run --quiet "$root/scripts/sha_mirror_census.py"
else
  python3 "$root/scripts/sha_mirror_census.py"
fi
