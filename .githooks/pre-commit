#!/usr/bin/env bash
# Governance pre-commit gate (2026-07-27 adversarial-review hardening).
#
# Runs the constitutional checks — the ADR-0082 triad lint, the AD-2 anchor
# byte-immutability gate, and (since 2026-11-07, bug-log #154) the verdict-
# transcription fidelity check — before every commit. All are fast
# (~seconds; pure python3 + bash, no cargo). Until this hook existed, the
# gates ran only when an agent remembered (bug-log #66 documents what
# discipline-only enforcement ships).
#
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass (emergencies):    git commit --no-verify
# Docs: docs/runbooks/ops-push-and-cache.md § Local governance hooks
set -euo pipefail
root="$(git rev-parse --show-toplevel)"

# spec_lint.py declares `requires-python = ">=3.11"` in a PEP-723 header, and invoking it as
# `python3 <script>` bypasses that declaration entirely — the gate then dies on
# `ModuleNotFoundError: tomllib` if whatever `python3` resolves to is older. That is not
# hypothetical: it happened on 2026-10-10, mid-session, when a Homebrew update (uv 0.13.0,
# 2026-10-09) left `/usr/bin/python3` 3.9.6 as the only python3 on PATH. The gate had passed all
# morning and then blocked every commit.
#
# `uv run` reads the PEP-723 header and selects (or fetches) a compatible interpreter, so the
# script's own stated requirement is what decides — not whatever is first on PATH today. The
# python3 fallback keeps the hook working on a clone without uv, where it will fail loudly for
# the same reason rather than silently skipping.
if command -v uv >/dev/null 2>&1; then
  uv run --quiet "$root/scripts/spec_lint.py"
else
  python3 "$root/scripts/spec_lint.py"
fi
bash "$root/scripts/verify_anchors.sh" | tail -1

# bug-log #154 (2026-11-07): the F / V / V-REG verdict classifiers each live in a [[bin]],
# so no integration test can call them and each is instead "tested" by a file that
# re-implements it. All three claim the copy is verbatim; nothing enforced the word. This
# pins both sides' branch conditions against a set declared in the script. Same uv-vs-python3
# reasoning as above.
if command -v uv >/dev/null 2>&1; then
  uv run --quiet "$root/scripts/verdict_transcription_check.py"
else
  python3 "$root/scripts/verdict_transcription_check.py"
fi

# bug-log #163: `cargo test` skips a target whose required-features are not enabled
# SILENTLY — no warning, exit 0. 46 test fns across 13 targets had never run in CI and
# nothing said so. This does not decide which features CI enables; it makes every
# feature-gated target DECLARED, so a new silent exclusion cannot be added unseen.
# Same uv-vs-python3 reasoning as above.
if command -v uv >/dev/null 2>&1; then
  uv run --quiet "$root/scripts/feature_gated_targets_check.py"
else
  python3 "$root/scripts/feature_gated_targets_check.py"
fi

# bug-log #179 (2026-11-08): `verify_anchors.sh` above asks whether each anchors.toml row's
# SHA matches a committed body. It is perfectly happy when TWO rows of one scenario point at
# the SAME body — so a re-emission that runs one invocation and writes its output to two rows
# silently merges two friction namespaces, and the gate still prints 119/119. That already
# happened once (the 2026-10-29 re-lock put default zero-slippage output into six CANONICAL
# rows, measured as a 28 pp gap against a real --sim-slippage-bps 8 run) and the next
# re-emission was about to do the mirror of it. This declares how many DISTINCT bodies each
# scenario's rows point at, so neither a collapse nor a split can land unseen.
# Same uv-vs-python3 reasoning as above.
if command -v uv >/dev/null 2>&1; then
  uv run --quiet "$root/scripts/anchor_namespace_collapse_check.py"
else
  python3 "$root/scripts/anchor_namespace_collapse_check.py"
fi

# bug-log #183 durable fix (2026-11-08): the tool that maps every in-test SHA literal to its
# anchors.toml row was never GATED — it appeared in this hook and in CI only inside comments
# ABOUT it. So the 75 pins it checks were verified when somebody remembered to run it, and
# the stale pin of #181 was caught by a Rust test on three CI legs instead, hours later.
# It is pure Python over source + anchors.toml: no cargo, no build, nothing to wait for.
# Same uv-vs-python3 reasoning as above.
if command -v uv >/dev/null 2>&1; then
  uv run --quiet "$root/scripts/check_determinism_anchors.py" --pre-commit
else
  python3 "$root/scripts/check_determinism_anchors.py" --pre-commit
fi

# bug-log #183 (2026-11-08): a body SHA is pinned in anchors.toml AND copied into source.
# When #183 was filed, `check_determinism_anchors.py` synced five of the NINE files that
# mirror a current anchors row, and the uncovered one holding 35 of them took CI red on
# all three legs. The #183 durable fix put eight of the nine under that tool (gated just
# above); this census answers "how many places is a SHA pinned?" mechanically and pins
# the answer, so a stale copy — which stops matching, dropping the file's count — cannot
# land unseen. Its uncovered count is DERIVED from the sync tool's own file list.
# Same uv-vs-python3 reasoning as above.
if command -v uv >/dev/null 2>&1; then
  uv run --quiet "$root/scripts/sha_mirror_census.py"
else
  python3 "$root/scripts/sha_mirror_census.py"
fi

# ── 2026-11-10 (bug-log #190): five gates that existed and ran nowhere ────────
#
# A census of every `--self-test`-bearing script under `scripts/` against this
# hook and `ci.yml` found SIX wired and FIVE not — including
# `adr_registry_check.py`, which CLAUDE.md's AD-18 non-negotiable names *as* the
# enforcement ("plus its Registry row in the same commit — enforced by
# `scripts/adr_registry_check.py`"). It was flagged unwired by the 2026-08-17
# and 2026-08-24 audits and was still unwired on 2026-11-10. The proof it
# matters arrived the same morning: ADR-0102 was written and the row was added
# only because the script was run BY HAND, and the script is what caught the
# omission.
#
# Split by WHERE the invariant can still be saved, not by runtime:
#   - here AND in ci.yml: the four sub-second gates, plus the secrets scan.
#     The secrets scan costs 2.95 s, which is the most expensive thing in this
#     hook after `verify_anchors.sh` — and it belongs here anyway, because
#     "No secrets in git" (AD-19) is unsaveable once a commit is pushed. A
#     secret caught in CI is a secret that is already on the remote.
#   - ci.yml ONLY: `check_no_raw_asof_join.sh` (6.0 s, 413 production files).
#     PIT discipline is fixable after the fact, so it does not earn 6 s on
#     every commit.
# Measured, not estimated: this hook was 9.91 s before these lines and 15.24 s
# after. The first draft of this comment said "~13.5 s" from arithmetic on the
# individual timings; the whole point of the gate below it is that a number you
# did not measure is not a number.
#
# Known gap, not fixed here: `check_no_secrets_in_llm_artifacts.sh` has NO
# `--self-test` (it answers `--self-test` with "unknown flag"), so it is the one
# gate below whose teeth are unmeasured. Its probe is its own task.

# AD-18: an ADR without its Registry row, or a row without its ADR, is drift.
if command -v uv >/dev/null 2>&1; then
  uv run --quiet "$root/scripts/adr_registry_check.py"
  uv run --quiet "$root/scripts/adr_registry_check.py" --self-test
else
  python3 "$root/scripts/adr_registry_check.py"
  python3 "$root/scripts/adr_registry_check.py" --self-test
fi

# AD-19: no secrets in git. Unsaveable after a push, which is why it is here.
#
# `--min-files 1` is DECLARED at the call site, not left to the default, because
# bug-log `#193` found this gate printing PASS without saying what it read: of
# its four default targets exactly one is tracked, so on a fresh checkout it
# scans a single fixture database. The count is now on the PASS line — compare
# it between here and CI and the difference is the point. The `--self-test`
# line is new too: until 2026-11-10 this was the only gate in this hook with no
# probe, which for the gate enforcing AD-19 was the worst one to leave
# unmeasured.
# `--scan-spec` is WIRED as of 2026-11-10, and that is the point of bug-log
# `#193`: this leg greps `evidence/`, `docs/` and `_bmad-output/`, so it is the
# one that would catch a key pasted into a runbook, a story or a report — the
# realistic AD-19 risk here — and it had been permanently opt-OUT because it
# reported 14 hits, every one a false positive. The fix was to sharpen the rule,
# not to excuse the matches: docs are scanned with the boundary-anchored key
# SHAPE plus the two V9 synthetic keys, NOT the bare literal prefixes, because a
# bare `sk-ant-` is six characters of documentation and over prose those
# prefixes match any document that DISCUSSES them. Measured over 1323 doc files:
# the literal set reports 14, the shape set reports 1 — and that 1 is allowlisted
# with a reason, re-verified on every run as still existing and still matching,
# so the hole cannot rot open.
#
# `--min-files 1300` against ~1324 in CI and ~1360 here: a floor, not a count,
# sized so a collapsed or mis-rooted walk cannot pass as clean.
#
# Cost measured, because it decides whether this belongs in a HOOK: the doc leg
# was 24.3 s when it called grep three times per file, which took this hook from
# 15 s to 48 s. Batched into three passes it is 3.7 s. A hook nobody waits for is
# a hook that gets `--no-verify`.
bash "$root/scripts/check_no_secrets_in_llm_artifacts.sh" --scan-spec --min-files 1300
bash "$root/scripts/check_no_secrets_in_llm_artifacts.sh" --self-test

# AD-10: the visual baselines are byte-compared, so a clock or RNG call on the
# snapshot path makes them non-deterministic. Rebuilt 2026-11-10 — it had been
# RED (on two doc comments and one wrapped marker) with nothing running it.
bash "$root/scripts/check_no_clocks_in_ui_tests.sh"
bash "$root/scripts/check_no_clocks_in_ui_tests.sh" --self-test

# The operator-ledger schema and the backlog Queue's staleness: both sub-second,
# both pure stdlib, both previously enforced by whoever remembered.
if command -v uv >/dev/null 2>&1; then
  uv run --quiet "$root/scripts/operator_ledger_check.py"
  uv run --quiet "$root/scripts/operator_ledger_check.py" --self-test
  uv run --quiet "$root/scripts/queue_staleness_check.py"
  uv run --quiet "$root/scripts/queue_staleness_check.py" --self-test
else
  python3 "$root/scripts/operator_ledger_check.py"
  python3 "$root/scripts/operator_ledger_check.py" --self-test
  python3 "$root/scripts/queue_staleness_check.py"
  python3 "$root/scripts/queue_staleness_check.py" --self-test
fi

# bug-log #195 (2026-11-10): the bug-log's own header declares a Status schema — four
# values, and a landing commit on every fixed/partial-fix row — and nothing read it.
# Measured over 139 entries: 36% had no Status line at all. Gated from `#189` only: ONE
# declared number in the script, not an exemption list, and the PASS line counts what it
# leaves out. It belongs HERE, not only in CI, because a Status line is cheapest to fix
# before the commit exists. Measured: 0.55 s live + 1.0 s self-test.
#
# `--staged` reads the bug-log from the INDEX being committed, not the working tree
# (2026-11-10 review, FP3/BYP-5/F3): an unstaged draft entry must not block an
# unrelated commit, and a violation staged and then "fixed" only on disk must not pass.
# This hook is handed git's own environment — under `git commit -a`, GIT_INDEX_FILE is an
# ABSOLUTE path to the index.lock of the commit being made (measured, git 2.50.1) — so
# the staged read keeps that variable on purpose, and every other git call the script
# makes (above all the self-test's throwaway repos) scrubs GIT_*. Probes P11/P12g pin both,
# and P14 re-runs the whole self-test under a hook's GIT_INDEX_FILE.
#
# The live check runs on EVERY commit (measured 1.2 s via uv). The self-test runs only when
# this commit touches the gate or this hook, and says so when it does not: it costs 12.7 s
# (measured — P14 runs it twice), it protects the gate's CODE, which only changes when the
# script does, and CI runs it on every push. Same split as `check_no_raw_asof_join.sh`
# above: what is fixable after the fact does not earn a dozen seconds on every commit.
if command -v uv >/dev/null 2>&1; then
  uv run --quiet "$root/scripts/bug_log_schema_check.py" --staged
else
  python3 "$root/scripts/bug_log_schema_check.py" --staged
fi
if git diff --cached --name-only -- scripts/bug_log_schema_check.py .githooks/pre-commit | grep -q .; then
  if command -v uv >/dev/null 2>&1; then
    uv run --quiet "$root/scripts/bug_log_schema_check.py" --self-test
  else
    python3 "$root/scripts/bug_log_schema_check.py" --self-test
  fi
else
  echo "bug-log schema self-test: not run (the gate and this hook are unchanged in this commit; CI runs it on every push)"
fi
