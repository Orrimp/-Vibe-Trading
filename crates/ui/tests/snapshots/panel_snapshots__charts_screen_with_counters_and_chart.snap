screen: charts
layout: chip_row + status_strip + chart + histogram
layout_resolution: Q5_beta
histogram_height_px: 80
chips:
  rule=ACCENT venue=binance symbol=BTCUSDT
  rule=— venue=binance symbol=ETHUSDT
  rule=— venue=binance symbol=SOLUSDT
